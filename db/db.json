{
  "poems": [
    {
      "title": "短歌行",
      "content": "你看是不是变了！",
      "pic": "https://gitee.com/wangyao_jsj/project2024_01/raw/master/img/6.jpg"
    },
    {
      "title": "雨晴",
      "content": "雨前初见花间蕊，雨后全无叶底花。",
      "pic": "https://gitee.com/wangyao_jsj/project2024_01/raw/master/img/2.jpg"
    },
    {
      "title": "登楼",
      "content": "花近高楼伤客心，万方多难此登临。",
      "pic": "https://gitee.com/wangyao_jsj/project2024_01/raw/master/img/3.jpg"
    },
    {
      "title": "鹊桥仙·纤云弄巧",
      "content": "纤云弄巧，飞星传恨，银汉迢迢暗度。",
      "pic": "https://gitee.com/wangyao_jsj/project2024_01/raw/master/img/4.jpg"
    },
    {
      "title": "静夜思",
      "content": "床前明月光，疑是地上霜。举头望明月，低头思故乡。",
      "pic": "db/img/jingyesi.jpg"
    },
    {
      "title": "登鹳雀楼",
      "content": "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。",
      "pic": "db/img/denglou.jpg"
    }
  ],
  "authors": [
